<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.offthescales.controller.SongSelectController">
   <children>
      <VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="25.0" style="-fx-background-color: linear-gradient(to bottom, #5a0000, #444444);">
         <children>
            <Label text="Select A Song:" textAlignment="CENTER" textFill="WHITE">
               <VBox.margin>
                  <Insets bottom="35.0" />
               </VBox.margin>
               <font>
                  <Font name="Impact" size="37.0" />
               </font>
            </Label>
            <Button fx:id="Song1Button" mnemonicParsing="false" onMouseClicked="#Song1Clicked" style="-fx-font-family: 'Impact'; -fx-font-size: 16px; -fx-background-color: black; -fx-text-fill: white; -fx-border-color: grey; -fx-border-width: 2;" text="Song 1" />
            <Button fx:id="Song2Button" mnemonicParsing="false" onMouseClicked="#Song2Clicked" style="-fx-font-family: 'Impact'; -fx-font-size: 16px; -fx-background-color: black; -fx-text-fill: white; -fx-border-color: grey; -fx-border-width: 2;" text="Song 2" />
            <Button fx:id="Song3Button" mnemonicParsing="false" onMouseClicked="#Song3Clicked" style="-fx-font-family: 'Impact'; -fx-font-size: 16px; -fx-background-color: black; -fx-text-fill: white; -fx-border-color: grey; -fx-border-width: 2;" text="Song 3" />
            <Button fx:id="MainMenuButton" mnemonicParsing="false" onMouseClicked="#MainMenuClicked" style="-fx-font-family: 'Impact'; -fx-font-size: 16px; -fx-background-color: black; -fx-text-fill: white; -fx-border-color: grey; -fx-border-width: 2;" text="Main Menu">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
